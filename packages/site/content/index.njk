---
layout: layouts/base.njk
title: ""
wide: true
---
{% set s = site.social %}

<main class="home">

  <section class="hero hero--band">
    <div>
      <h1 class="hero-title">{{ site.title }}!</h1>
      <p class="hero-show">{{ site.show.title }}</p>
    </div>
    <p class="hero-blurb">{{ site.show.blurb }}</p>
  </section>

  <div class="band-strip" aria-hidden="true">
    {#- Phones hide photos 4 to 6, so lazy-load those to skip the download. -#}
    {% for n in range(1, 7) %}<img src="{{ ('/band/' + n + '.jpg') | rel }}" alt="" width="270" height="360"{% if n > 3 %} loading="lazy"{% endif %} />{% endfor %}
  </div>

  <section id="gigs" aria-labelledby="gigs-head">
    <h2 class="section-head" id="gigs-head">Coming up</h2>
    {% if upcomingGigs.length %}
    <div class="gig-cards">
      {% for g in upcomingGigs %}
      <article class="gig-card">
        <p class="gig-card__date"><span>{{ g.dayLabel }}</span> {{ g.dateLabel }}</p>
        <div class="gig-card__body">
          <h3 class="venue-name"><a href="{{ g.url }}" rel="external">{{ g.name }}</a></h3>
          <p class="venue-address">{% if g.mapUrl %}<a href="{{ g.mapUrl }}" rel="external">{{ g.venue }}</a>{% else %}{{ g.venue }}{% endif %}, {{ g.address }}</p>
          <p class="gig-card__time">{{ g.timeLabel }}</p>
          <p class="gig-card__blurb">{{ g.blurb }}</p>
          <p class="gig-card__cta">
            {% if g.ticketsUrl %}<a class="btn btn--primary btn--red" href="{{ g.ticketsUrl }}" rel="external">{{ g.ticketsLabel or "Get tickets" }}</a>{% else %}<span class="stamp">Free in, just turn up</span>{% endif %}
          </p>
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="no-gigs">Nothing booked right now. New dates land on Instagram first.</p>
    {% endif %}
  </section>

  {% if collections.backCatalogue.length %}
  <section id="back-catalogue" aria-labelledby="back-catalogue-head">
    <h2 class="section-head" id="back-catalogue-head">The back catalogue</h2>
    <div class="gig-cards">
      {% for entry in collections.backCatalogue.slice(0, 3) %}
      {% include "partials/back-catalogue-card.njk" %}
      {% endfor %}
    </div>
    <p class="more-link"><a href="{{ '/back-catalogue/' | rel }}">The whole back catalogue</a>, with set lists from past gigs.</p>
  </section>
  {% endif %}

  <section class="follow" id="follow" aria-labelledby="follow-head">
    <h2 class="section-head" id="follow-head">Stay in the loop</h2>
    <p>
      New gigs land on Instagram first{% if not s.instagram %} (coming soon){% endif %}, along
      with anything that moves.
    </p>
    <p class="follow-row">
      {% if s.instagram %}<a class="btn btn--primary" href="{{ s.instagram }}" rel="external">Follow on Instagram</a>{% else %}<span class="btn btn--ghost is-disabled" aria-disabled="true">Instagram — coming soon</span>{% endif %}
    </p>
    <p class="contact-line">
      Bookings or hellos? {% include "partials/email-link.njk" %}
    </p>
  </section>

</main>
