---
layout: layouts/base.njk
---
{#- One back-catalogue entry: a festival run or a one-off gig, from a
    content/back-catalogue/*.md file. Each section renders only when the
    entry has content for it. -#}
{#- A song on the sheet. `n` is its place in the running order, if it has
    one. A song with a `video` links to it on YouTube (within the entry's
    playlist, the link stretched over the whole row) with its self-hosted
    thumbnail. `thumbs` is the thumbnail folder, already made page-relative
    (the rel filter can't see the page in here). -#}
{% macro songRow(s, n, thumbs, playlist) %}
<li class="song{% if s.video %} song--video{% endif %}">
  {% if n %}<span class="song-n">{{ n }}</span>{% endif %}
  <span class="song-name">
    {%- if s.video -%}
    <a class="song__link" href="https://www.youtube.com/watch?v={{ s.video }}{% if playlist %}&amp;list={{ playlist }}{% endif %}" rel="external">{{ s.song }}<span class="visually-hidden"> (watch on YouTube)</span></a>
    {%- else %}{{ s.song }}{% endif -%}
  </span>
  <span class="song-artist">{{ s.artist }}</span>
  {% if s.video %}<span class="song__thumb" aria-hidden="true"><img src="{{ thumbs + s.video + '.jpg' }}" alt="" width="320" height="180" loading="lazy" /></span>{% endif %}
</li>
{% endmacro %}
{% set thumbs = videoBase | rel %}
<main class="entry">

  <section class="hero hero--compact">
    <a class="back" href="{{ '/back-catalogue/' | rel }}">The back catalogue</a>
    {% if logo %}<img class="festival-logo" src="{{ logo.src | rel }}" alt="{{ logo.alt }}" width="100" height="100" />{% endif %}
    <h1 class="hero-title">{{ title }}</h1>
    <p class="hero-show entry-when">{{ dates }}, {{ venues }}</p>
    <div class="hero-blurb">{{ content | safe }}</div>
  </section>

  {% if setlist %}
  <section class="sheet" aria-labelledby="setlist-head">
    <h2 class="sheet-head" id="setlist-head">The set list</h2>
    <ol class="songs">
      {% for s in setlist %}{{ songRow(s, loop.index, thumbs, playlist) }}{% endfor %}
    </ol>
    {% if playlist %}
    <p class="sheet-foot">
      Songs with a picture link to the video.
      <a href="https://www.youtube.com/playlist?list={{ playlist }}" rel="external">Watch the whole {{ title }} playlist on YouTube</a>.
    </p>
    {% endif %}
  </section>
  {% endif %}

  {% if extras %}
  <section aria-labelledby="extras-head">
    <h2 class="section-head" id="extras-head">Off the list</h2>
    <p>One-offs, requests and the odd dare.</p>
    <div class="sheet">
      <ul class="songs songs--extras">
        {% for s in extras %}{{ songRow(s, null, thumbs, playlist) }}{% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% if photos %}
  <section aria-labelledby="photos-head">
    <h2 class="section-head" id="photos-head">Photos</h2>
    {#- A strip of film: square frames, numbered like the edge print on a
        negative. Each links to the full-size print; the lightbox below
        takes over when JavaScript is on. -#}
    <ol class="film">
      {% for p in photos %}
      <li class="film__frame">
        <a href="{{ (photoBase + p.n + '.jpg') | rel }}" data-caption="{{ p.where }}">
          <img src="{{ (photoBase + p.n + '-thumb.jpg') | rel }}" alt="{{ p.alt }}" width="400" height="400" loading="lazy" decoding="async" />
        </a>
        <span class="film__number" aria-hidden="true">{{ loop.index }}A</span>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

</main>

{% if photos %}
<dialog class="lightbox" aria-label="Photo viewer">
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <div class="lightbox__bar">
    <button class="btn btn--primary" type="button" data-step="-1">Previous</button>
    <span data-count></span>
    <button class="btn btn--primary" type="button" data-step="1">Next</button>
    <button class="btn btn--primary" type="button" data-close>Close</button>
  </div>
</dialog>
<script>
  // Open film frames in the lightbox; arrow keys step, Escape closes.
  (function () {
    var links = [].slice.call(document.querySelectorAll(".film a"));
    var box = document.querySelector(".lightbox");
    if (!box.showModal) return;
    var img = box.querySelector("img");
    var caption = box.querySelector("figcaption");
    var count = box.querySelector("[data-count]");
    var at = 0;
    function show(i) {
      at = (i + links.length) % links.length;
      var thumb = links[at].querySelector("img");
      img.src = links[at].href;
      img.alt = thumb.alt;
      caption.textContent = thumb.alt + " " + links[at].dataset.caption + ".";
      count.textContent = at + 1 + " of " + links.length;
      // Warm the neighbours so stepping through doesn't wait on the network.
      [at - 1, at + 1].forEach(function (i) {
        new Image().src = links[(i + links.length) % links.length].href;
      });
    }
    links.forEach(function (link, i) {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        show(i);
        box.showModal();
      });
    });
    box.addEventListener("click", function (e) {
      var step = e.target.getAttribute("data-step");
      if (step) show(at + Number(step));
      else if (e.target === box || e.target.hasAttribute("data-close")) box.close();
    });
    box.addEventListener("keydown", function (e) {
      if (e.key === "ArrowRight") show(at + 1);
      if (e.key === "ArrowLeft") show(at - 1);
    });
  })();
</script>
{% endif %}
