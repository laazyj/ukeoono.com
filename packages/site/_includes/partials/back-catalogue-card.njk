{#- A played gig's ticket: the same card as an upcoming gig, stamped as
    used. Expects `entry`, an item from collections.backCatalogue. -#}
{% set d = entry.data %}
<a class="gig-card gig-card--played" href="{{ entry.url | rel }}">
  <p class="gig-card__date">{{ d.when }}{% if d.shows > 1 %} <small>{{ d.shows }} shows</small>{% endif %}</p>
  <span class="gig-card__body">
    <span class="stamp played" aria-hidden="true">Played</span>
    <span class="venue-name">{{ d.title }}</span>
    <span class="gig-card__blurb">{{ d.summary }}</span>
    {% if d.setlist %}<span class="gig-card__has">{{ d.setlist.length }} songs on the set list</span>{% endif %}
  </span>
</a>
