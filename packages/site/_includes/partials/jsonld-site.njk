{% set ogImage = site.url + site.defaultOgImage %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": {{ site.title | dump | safe }},
      "description": {{ site.description | dump | safe }},
      "inLanguage": "{{ site.language }}",
      "publisher": { "@id": "{{ site.author.id }}" }
    },
    {
      "@type": ["Organization", "MusicGroup"],
      "@id": "{{ site.author.id }}",
      "name": {{ site.author.name | dump | safe }},
      "url": "{{ site.url }}/",
      "description": {{ site.description | dump | safe }},
      "areaServed": {{ (site.city + ", Scotland") | dump | safe }},
      "sameAs": {{ [site.social.instagram, site.social.facebook] | compact | dump | safe }}
    }{% for p in site.team %},
    {{ p | personNode | dump | safe }}{% endfor %}{% for e in eventList %},
    {% set fest = e.festival or site.festival %}
    {
      "@type": "Event",
      "@id": "{{ site.url }}/#gig-{{ e.startDate }}",
      "name": {{ (e.name or site.author.name + " — " + site.show.title) | dump | safe }},
      "description": {{ (e.blurb or site.show.blurb) | dump | safe }},
      "startDate": "{{ e.startDate }}",
      "endDate": "{{ e.endDate }}",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      {% if not e.ticketsUrl %}"isAccessibleForFree": true,
      {% endif %}"offers": {
        "@type": "Offer",{% if not e.ticketsUrl %}
        "price": "0",
        "priceCurrency": "GBP",{% endif %}
        "availability": "https://schema.org/InStock",
        "url": {{ (e.ticketsUrl or site.url + "/") | dump | safe }}
      },
      "image": [{{ ogImage | dump | safe }}],
      "inLanguage": "{{ site.language }}",
      "organizer": { "@id": "{{ site.author.id }}" },
      "performer": { "@id": "{{ site.author.id }}" },
      "superEvent": {
        "@type": "{{ fest.type or "Festival" }}",
        "name": {{ fest.name | dump | safe }}{% if fest.url %},
        "url": {{ fest.url | dump | safe }}{% endif %}
      },
      "location": {
        "@type": "Place",
        "name": {{ e.venue | dump | safe }}{% if e.address %},
        "address": {{ e.address | dump | safe }}{% endif %}{% if e.mapUrl %},
        "hasMap": {{ e.mapUrl | dump | safe }}{% endif %}
      }
    }{% endfor %}
  ]
}
</script>
